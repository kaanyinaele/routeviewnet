[Unit]
Description=RouteViewNet local network monitoring daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/routeviewnetd --config /etc/routeviewnet/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
User=routeviewnet
Group=routeviewnet
# CAP_NET_RAW: raw-socket ping fallback.
#
# CAP_SYS_PTRACE plus CAP_DAC_READ_SEARCH: read other users' /proc/[pid]/fd to
# attribute network connections to apps for the per-app data usage feature.
# /proc/[pid]/fd needs both the ptrace READ check and its owner-only directory
# permissions bypassed. No ptrace attach happens and no write access is
# granted — but be clear about the size of the grant: CAP_DAC_READ_SEARCH
# bypasses *every* file-read permission check on the system, not just the ones
# under /proc. The daemon does not read anything else, and the sandboxing
# below fences off the obvious credential stores, but the capability itself is
# broad.
#
# If you do not want per-app data usage, set
# collection.enable_app_traffic_monitoring: false in config.yaml AND drop
# CAP_SYS_PTRACE/CAP_DAC_READ_SEARCH from both lines below
# (systemctl edit routeviewnetd). Disabling the feature alone stops the reads;
# it cannot drop a capability systemd already granted the process.
AmbientCapabilities=CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=true

# Sandboxing (spec §15.2 [v1.2]): the daemon only needs read access to
# /proc and /sys plus write access to its own state directory.
# ProtectProc/ProcSubset deliberately NOT set — the process-memory
# collector reads other processes' /proc/[pid]/status.
ProtectSystem=strict
ReadWritePaths=/var/lib/routeviewnet
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# ProtectSystem/ProtectHome restrict writes and hide /home, but they do not
# stop reads elsewhere, and CAP_DAC_READ_SEARCH ignores file permissions. Deny
# the credential stores outright so a compromised daemon cannot read them.
InaccessiblePaths=-/etc/shadow -/etc/gshadow -/etc/ssh -/etc/ssl/private -/root

[Install]
WantedBy=multi-user.target
